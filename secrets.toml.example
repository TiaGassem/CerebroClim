# Streamlit Cloud > your app > Settings > Secrets. NEVER commit real keys.
# EASIEST (free, delivers to ANY address, ~500 mails/day): Gmail SMTP with an App Password.
# Google account > Security > 2-Step Verification ON > App passwords > create one for "CerebroClim".
[smtp]
host = "smtp.gmail.com"
port = 587
username = "your.address@gmail.com"
password = "16-letter-app-password"
sender = "your.address@gmail.com"

# OPTIONAL (needs your own verified domain at resend.com/domains; the test sender only reaches your own address):
# resend_api_key = "re_xxxxxxxx"
# resend_from = "CerebroClim <alerts@your-domain.com>"
